{
  "name": "@house-id/rrule-helper",
  "version": "1.0.0",
  "description": "Package for getting localized descriptive text from rrule",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "release": "npm run build && semantic-release",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/House-ID/rrule-helper.git"
  },
  "keywords": [],
  "author": "House:ID AB",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/House-ID/rrule-helper/issues"
  },
  "homepage": "https://github.com/House-ID/rrule-helper#readme",
  "files": [
    "dist/**/*",
    "index.js",
    "english.js",
    "swedish.js"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "rrule": "^2.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.4",
    "@semantic-release/npm": "^12.0.1",
    "husky": "^9.0.11",
    "rimraf": "^6.0.1",
    "semantic-release": "^23.1.1",
    "typescript": "^5.0.4",
    "vitest": "^4.1.0"
  }
}
